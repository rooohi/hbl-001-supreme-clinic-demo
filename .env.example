# Public canonical URL used for metadata and patient booking links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fail closed: private previews emit noindex headers, disallow robots, and omit
# the sitemap. Set true only after the public-launch gates in SECURITY.md pass.
# This value is evaluated at build time, so rebuild after changing it.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Upstream private access must provide oai-authenticated-user-email in production.
# Comma-separated bootstrap owners are allowed only for initial tenant activation;
# remove them after persistent owner membership is provisioned.
AUTH_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_OWNER_EMAILS=

# Optional provider credentials. The application reports NOT_CONFIGURED when absent.
WHATSAPP_PROVIDER_TOKEN=
SMS_PROVIDER_TOKEN=
EMAIL_PROVIDER_TOKEN=

# Optional AI gateway. Aggregate operational facts only are sent by the current
# workflow; the UI remains explicitly NOT CONNECTED when either value is absent.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_MODEL=

# Razorpay adapter and verified webhook state. Never expose these server values
# to the browser and never mark a subscription active from a client callback.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Application-level encryption key reference for production patient PII.
PII_KEY_REF=
